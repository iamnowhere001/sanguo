{
  "name": "sanguo-baye",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim:battle": "vite-node scripts/sim-battle.ts",
    "sim:economy": "vite-node scripts/sim-economy.ts",
    "audit:ai": "vite-node scripts/ai-audit.ts",
    "map:check": "vite-node scripts/gen-map.ts",
    "map:gates": "vite-node scripts/gate-check.ts",
    "perf:check": "vite-node scripts/perf-check.ts",
    "bench:render": "node scripts/render-bench.mjs",
    "contrast:check": "vite-node scripts/contrast-check.ts",
    "verify": "npm run typecheck && npm test && npm run contrast:check && npm run build"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
